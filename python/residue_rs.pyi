"""Exact integer arithmetic in a Residue Number System (type stubs)."""

from collections.abc import Iterable, Iterator, Sequence
from typing import Any

__version__: str


class Base:
    """A choice of RNS base: `Base(bits=200)` or `Base(channels=8)`."""

    def __init__(self, bits: int | None = None, *, channels: int | None = None) -> None: ...
    @property
    def channels(self) -> int: ...
    @property
    def max_bits(self) -> int: ...
    @property
    def primes(self) -> list[int]: ...
    @staticmethod
    def available() -> list[int]: ...

    def vector(self, data: Iterable[int] | Any) -> Vector:
        """From Python ints or a one-dimensional int64 array."""

    def matrix(self, data: Iterable[Iterable[int]] | Any) -> Matrix:
        """From rows of Python ints or a two-dimensional int64 array."""

    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...


class Vector:
    """Exact signed integers modulo the primes of one base."""

    def __len__(self) -> int: ...
    def __getitem__(self, i: int) -> int: ...
    def __iter__(self) -> Iterator[int]: ...
    def __add__(self, other: Vector) -> Vector: ...
    def __sub__(self, other: Vector) -> Vector: ...
    def __mul__(self, other: Vector | int) -> Vector: ...
    def __rmul__(self, other: int) -> Vector: ...
    def __neg__(self) -> Vector: ...
    def dot(self, other: Vector) -> int: ...
    def sum(self) -> int: ...
    def tolist(self) -> list[int]: ...

    def to_numpy(self) -> Any:
        """A NumPy int64 array; OverflowError if a value does not fit."""
    @property
    def base(self) -> Base: ...
    @property
    def bits_bound(self) -> int: ...


class Matrix:
    """A matrix of exact signed integers modulo the primes of one base."""

    @property
    def shape(self) -> tuple[int, int]: ...
    @property
    def base(self) -> Base: ...
    @property
    def T(self) -> Matrix: ...
    def __matmul__(self, other: Matrix) -> Matrix: ...
    def __add__(self, other: Matrix) -> Matrix: ...
    def __sub__(self, other: Matrix) -> Matrix: ...
    def __neg__(self) -> Matrix: ...
    def __getitem__(self, idx: tuple[int, int]) -> int: ...
    def det(self) -> int: ...
    def tolist(self) -> list[list[int]]: ...
    def to_numpy(self) -> Any: ...


class Modulus:
    """Arithmetic modulo an odd number of up to 4096 bits, in batches.

    Not constant time: do not use with secret data.
    """

    def __init__(self, m: int) -> None: ...
    @property
    def modulus(self) -> int: ...
    @property
    def channels(self) -> int: ...
    def pow_batch(self, xs: Iterable[int], e: int) -> list[int]: ...
    def mul_batch(self, xs: Iterable[int], ys: Iterable[int]) -> list[int]: ...
